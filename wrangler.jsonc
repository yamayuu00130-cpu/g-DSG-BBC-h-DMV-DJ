{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haishin-ok-git",
  "main": "worker.js",
  "compatibility_date": "2026-08-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "haishin-ok-db",
      "database_id": "4c3d6f7f-6ed6-4d16-8f52-f61a7cef3df8"
    }
  ]
}
